{
  "name": "agent-feed-challenge",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "^24.18.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "ingest": "tsx src/cli/ingest.ts",
    "report": "tsx src/cli/report.ts",
